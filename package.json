{
  "name": "schach9x9",
  "version": "2.0.0",
  "description": "Schach 9x9 Spiel",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "train": "npx tsx js/utils/OpeningBookTrainer.ts",
    "train:fast": "npx tsx js/utils/OpeningBookTrainer.ts --games 50",
    "train:thorough": "npx tsx js/utils/OpeningBookTrainer.ts --games 500",
    "build": "npx vite build",
    "start": "npx serve .",
    "dev": "npx vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test:visual": "npx playwright test --grep @visual",
    "test:visual:update": "npx playwright test --grep @visual --update-snapshots",
    "test:coverage": "vitest run --coverage",
    "changelog": "node scripts/changelog.mjs",
    "match:stockfish": "npx tsx tools/stockfish-match.ts",
    "postinstall": "npm rebuild rolldown vite || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdoc": "^4.0.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stockfish": "^18.0.8",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "three": "^0.185.1"
  },
  "license": "WTFPL",
  "overrides": {
    "undici": "^7.29.0",
    "brace-expansion": "^2.1.2",
    "eslint": {
      "js-yaml": "5.3.0"
    },
    "@eslint/eslintrc": {
      "js-yaml": "5.3.0"
    },
    "js-yaml": "5.3.0"
  }
}