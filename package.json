{
  "name": "schach9x9",
  "version": "2.0.0",
  "description": "Schach 9x9 Spiel",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "train": "npx tsx js/utils/OpeningBookTrainer.ts",
    "train:fast": "npx tsx js/utils/OpeningBookTrainer.ts --games 50",
    "train:thorough": "npx tsx js/utils/OpeningBookTrainer.ts --games 500",
    "build": "npx vite build",
    "start": "npx serve .",
    "dev": "npx vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test:visual": "npx playwright test --grep @visual",
    "test:visual:update": "npx playwright test --grep @visual --update-snapshots",
    "test:coverage": "vitest run --coverage",
    "changelog": "node scripts/changelog.mjs",
    "match:stockfish": "npx tsx tools/stockfish-match.ts",
    "postinstall": "npm rebuild rolldown vite || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stockfish": "^18.0.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "gifenc": "^1.0.3",
    "three": "^0.186.1"
  },
  "license": "WTFPL",
  "overrides": {
    "undici": "^7.30.0",
    "brace-expansion": "^2.1.2",
    "eslint": {
      "js-yaml": "5.3.0"
    },
    "@eslint/eslintrc": {
      "js-yaml": "5.3.0"
    },
    "js-yaml": "5.3.0"
  }
}
